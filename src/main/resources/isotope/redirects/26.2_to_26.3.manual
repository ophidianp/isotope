isotope-redirects 1
# Hand-written rules for 26.2 -> 26.3, merged into the generated table at load time.
# Every line was checked with javap against both client jars. Read CLAUDE.md first.
from 26.2
to 26.3

# 26.3 removed the per-block codec system. In 26.2, BlockBehaviour declared simpleCodec(),
# propertiesCodec() and codec(), Block declared CODEC, and every block class had its own
# CODEC field. In 26.3 none of these exist, and no game code asks a block for a codec.
# Old mods still build one in a static initializer (CODEC = simpleCodec(MyBlock::new)), so
# the class dies with NoSuchMethodError before anything else runs. They get null instead:
# the only reader of that value was the game, which no longer reads it.
# A mod's OWN CODEC field is left alone (the lookup stops at a class that declares it).
# propertiesCodec() is deliberately NOT stubbed: its result is fed into RecordCodecBuilder
# by the mod, which would fail on null in a less obvious way.
s m net/minecraft/world/level/block/state/BlockBehaviour simpleCodec (Ljava/util/function/Function;)Lcom/mojang/serialization/MapCodec; per-block codecs were removed in 26.3
s f net/minecraft/world/level/block/Block CODEC Lcom/mojang/serialization/MapCodec; per-block codecs were removed in 26.3

# PushReaction: every constant was renamed AND the order changed, so matching by position
# would be wrong (it would turn DESTROY into PUSH). Mapping proven by usage: the same vanilla
# block / entity uses the old constant in 26.2 and the new one in 26.3.
#   DESTROY  -> POPPED         201 of 201 blocks in Blocks
#   BLOCK    -> IMMOVEABLE     11 of 11 blocks in Blocks
#   NORMAL   -> PUSH_PULL      Entity, BlockBehaviour$Properties default, PistonBaseBlock
#   IGNORE   -> IGNORE_ENTITY  8 of 8 classes (ArmorStand, Marker, Display, ...)
#   PUSH_ONLY-> PUSH           the remaining constant; the one PUSH in Blocks
f net/minecraft/world/level/material/PushReaction DESTROY Lnet/minecraft/world/level/material/PushReaction; POPPED
f net/minecraft/world/level/material/PushReaction BLOCK Lnet/minecraft/world/level/material/PushReaction; IMMOVEABLE
f net/minecraft/world/level/material/PushReaction NORMAL Lnet/minecraft/world/level/material/PushReaction; PUSH_PULL
f net/minecraft/world/level/material/PushReaction IGNORE Lnet/minecraft/world/level/material/PushReaction; IGNORE_ENTITY
f net/minecraft/world/level/material/PushReaction PUSH_ONLY Lnet/minecraft/world/level/material/PushReaction; PUSH

# Registry codec helpers moved and were renamed in 26.3 (checked with javap against both jars):
#   net.minecraft.core.RegistryCodecs -> net.minecraft.core.registries.codec.RegistryCodecs
#   homogeneousList(...) -> holderSet(...): same four overloads, same parameters, and the
#     short overloads pass the same defaults (false), so the calls are equivalent.
#   RegistryFileCodec.create(key, codec) was create(key, codec, true); in 26.3 that shortcut is
#     RegistryCodecs.holder(key, codec), which also passes true. Both new methods return the wider
#     Codec type, but the object is still a RegistryFileCodec (holder -> RegistryFileCodec.create
#     -> new RegistryFileCodec), so casting back to what the mod expects is safe.
c net/minecraft/core/RegistryCodecs net/minecraft/core/registries/codec/RegistryCodecs
m net/minecraft/core/RegistryCodecs homogeneousList (Lnet/minecraft/resources/ResourceKey;Lcom/mojang/serialization/Codec;Z)Lcom/mojang/serialization/Codec; holderSet
m net/minecraft/core/RegistryCodecs homogeneousList (Lnet/minecraft/resources/ResourceKey;Lcom/mojang/serialization/Codec;)Lcom/mojang/serialization/Codec; holderSet
m net/minecraft/core/RegistryCodecs homogeneousList (Lnet/minecraft/resources/ResourceKey;)Lcom/mojang/serialization/Codec; holderSet
m net/minecraft/core/RegistryCodecs homogeneousList (Lnet/minecraft/resources/ResourceKey;Z)Lcom/mojang/serialization/Codec; holderSet
m net/minecraft/resources/RegistryFileCodec create (Lnet/minecraft/resources/ResourceKey;Lcom/mojang/serialization/Codec;)Lnet/minecraft/resources/RegistryFileCodec; holder (Lnet/minecraft/resources/ResourceKey;Lcom/mojang/serialization/Codec;)Lcom/mojang/serialization/Codec; cast at=net/minecraft/core/registries/codec/RegistryCodecs
m net/minecraft/resources/RegistryFileCodec create (Lnet/minecraft/resources/ResourceKey;Lcom/mojang/serialization/Codec;Z)Lnet/minecraft/resources/RegistryFileCodec; create (Lnet/minecraft/resources/ResourceKey;Lcom/mojang/serialization/Codec;Z)Lcom/mojang/serialization/Codec; cast

# Pack$ResourcesSupplier was reshaped in 26.3 (checked with javap):
#   26.2: PackResources openPrimary(PackLocationInfo); PackResources openFull(PackLocationInfo, Pack$Metadata)
#   26.3: PackMetadataResources openMetadata(PackLocationInfo); Stream<PackResources> openResources(PackLocationInfo, Pack$Metadata)
# PackResources extends PackMetadataResources in 26.3, and vanilla's own suppliers return their
# primary resources from openMetadata and Stream.of(resources) from openResources; 26.2's
# openFull already merged overlays into one PackResources. So implementers that only have the old
# methods get the new ones as: openMetadata = openPrimary, openResources = Stream.of(openFull(...)).
a net/minecraft/server/packs/repository/Pack$ResourcesSupplier openPrimary (Lnet/minecraft/server/packs/PackLocationInfo;)Lnet/minecraft/server/packs/PackResources; openMetadata (Lnet/minecraft/server/packs/PackLocationInfo;)Lnet/minecraft/server/packs/PackMetadataResources;
a net/minecraft/server/packs/repository/Pack$ResourcesSupplier openFull (Lnet/minecraft/server/packs/PackLocationInfo;Lnet/minecraft/server/packs/repository/Pack$Metadata;)Lnet/minecraft/server/packs/PackResources; openResources (Lnet/minecraft/server/packs/PackLocationInfo;Lnet/minecraft/server/packs/repository/Pack$Metadata;)Ljava/util/stream/Stream; stream

# StructurePlacement was split in 26.3 (checked with javap). The abstract class became an
# interface with codec(); its state and logic moved to the new AbstractSpreadingStructurePlacement,
# together with its nested classes (same members; the enum has the same constants in the same order).
# RandomSpreadStructurePlacement keeps its members except type() -> codec(). The registry
# STRUCTURE_PLACEMENT now holds MapCodecs. StructurePlacementType (the old one-method "type" interface,
# codec()) is gone; old mods implement it with lambdas, so it is renamed to Isotope's own TypeObject,
# which has the same single method.
c net/minecraft/world/level/levelgen/structure/placement/StructurePlacement$ExclusionZone net/minecraft/world/level/levelgen/structure/placement/AbstractSpreadingStructurePlacement$ExclusionZone
c net/minecraft/world/level/levelgen/structure/placement/StructurePlacement$FrequencyReducer net/minecraft/world/level/levelgen/structure/placement/AbstractSpreadingStructurePlacement$FrequencyReducer
c net/minecraft/world/level/levelgen/structure/placement/StructurePlacement$FrequencyReductionMethod net/minecraft/world/level/levelgen/structure/placement/AbstractSpreadingStructurePlacement$FrequencyReductionMethod
c net/minecraft/world/level/levelgen/structure/placement/StructurePlacementType com/isotope/runtime/TypeObject
x net/minecraft/world/level/levelgen/structure/placement/StructurePlacement type ()Lnet/minecraft/world/level/levelgen/structure/placement/StructurePlacementType; codec ()Lcom/mojang/serialization/MapCodec;

# Placement modifiers became interfaces in 26.3 (checked with javap). In 26.2 PlacementModifier,
# PlacementFilter and RepeatingPlacement were abstract classes with no-argument constructors that only
# chain to Object(); subclasses implemented type() returning a PlacementModifierType (a one-method
# "type" interface, codec()), now removed. In 26.3 each is an interface with codec(), the registry
# PLACEMENT_MODIFIER_TYPE holds MapCodecs, and PlacementModifier.getPositions(ctx, random, pos) -> Stream
# was replaced by modify(ctx, random, pos, Consumer). PlacementFilter and RepeatingPlacement provide
# modify as a default method (from shouldPlace / count, which keep their signatures).
c net/minecraft/world/level/levelgen/placement/PlacementModifierType com/isotope/runtime/TypeObject
x net/minecraft/world/level/levelgen/placement/PlacementModifier type ()Lnet/minecraft/world/level/levelgen/placement/PlacementModifierType; codec ()Lcom/mojang/serialization/MapCodec;
x net/minecraft/world/level/levelgen/placement/PlacementFilter type ()Lnet/minecraft/world/level/levelgen/placement/PlacementModifierType; codec ()Lcom/mojang/serialization/MapCodec;
x net/minecraft/world/level/levelgen/placement/RepeatingPlacement type ()Lnet/minecraft/world/level/levelgen/placement/PlacementModifierType; codec ()Lcom/mojang/serialization/MapCodec;
a net/minecraft/world/level/levelgen/placement/PlacementModifier getPositions (Lnet/minecraft/world/level/levelgen/placement/PlacementContext;Lnet/minecraft/util/RandomSource;Lnet/minecraft/core/BlockPos;)Ljava/util/stream/Stream; modify (Lnet/minecraft/world/level/levelgen/placement/PlacementContext;Lnet/minecraft/util/RandomSource;Lnet/minecraft/core/BlockPos;Ljava/util/function/Consumer;)V foreach
